#!/usr/bin/env bash
# framewall (host): stream your physical screens plus N virtual monitors to a
# VR headset as ONE Moonlight stream, a "monitor wall".
#
# Runs on Linux with KDE Plasma 6 (Wayland). Virtual monitors come from
# krfb-virtualmonitor; a patched Sunshine (see ../sunshine) captures the
# bounding box of all screens through KWin's screencast protocol.
#
#   framewall install      write the Sunshine config + apps, enable the service
#   framewall apps         list the wall presets (Moonlight app names)
#   framewall up PRESET    create the wall for a preset (Sunshine runs this)
#   framewall down         remove the virtual monitors again
#   framewall status       show services and screens
#   framewall uninstall    stop and remove the service (config is kept)
#
# Settings: ~/.config/framewall/config (see config.example). After editing
# presets, run `framewall install` again; pairing is kept.
#
# Copyright (C) 2026 framewall contributors. GPL-3.0-or-later.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/framewall"
CONFIG="$CONFIG_DIR/config"
SELF="$(readlink -f "$0")"

# ---- defaults (override in $CONFIG) -----------------------------------------
NAME="$(hostname -s) wall"               # how the host shows up in Moonlight
PORT=48389                               # Sunshine base port (uses PORT-5 .. PORT+21)
SUNSHINE="$HOME/.local/opt/sunshine-wall/bin/sunshine"
ENCODER=vaapi                            # vaapi | nvenc | vulkan | software
ADAPTER=""                               # e.g. /dev/dri/renderD128 (empty = Sunshine's choice)
PHYSICAL=all                             # physical screens in the wall: all | primary |
                                         # "NAME NAME..." | none
PRESETS=(                                # "COUNT WIDTHxHEIGHT REFRESH LAYOUT"
    "2 1920x1080 120 top"
    "2 1920x1080 90 top"
)
SUNSHINE_DIR="$CONFIG_DIR/sunshine"      # Sunshine state (pairing), logs, apps
EXTRA_SUNSHINE_CONFIG=""                 # extra lines appended to sunshine.conf
# ------------------------------------------------------------------------------
[[ -r "$CONFIG" ]] && . "$CONFIG"

die() { echo "framewall: $*" >&2; exit 1; }

kscreen_json() { kscreen-doctor -j 2>/dev/null; }

# Plan a preset from KWin's current screens (kscreen-doctor -j on stdin).
#   plan COUNT W H LAYOUT
# Prints:
#   WALL w h              wall size (= stream size)
#   BLOCK w h             size of the block of physical screens in the wall
#   REGION x y w h        rectangle Sunshine captures
#   POS name x y          where each screen of the wall goes
#   SAVE name x y         original position of every other screen (restored by down)
#   WARN text
# Physical screens in the wall keep their arrangement (as one block); the
# virtual monitors Virtual-wall1..N are added around that block. Screens left
# out stay put, and the wall is placed to their right.
plan() {
    # The program itself arrives on python's stdin, so the screens go by env.
    FRAMEWALL_SCREENS="$(cat)" python3 - "$1" "$2" "$3" "$4" "$PHYSICAL" "${FRAMEWALL_EXTRA_PHYSICAL:-}" <<'PY'
import json, math, os, sys
n, w, h = int(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3])
shape, spec, extra = sys.argv[4], sys.argv[5].split(), sys.argv[6].split()
# KWin leaves "enabled" out for virtual outputs: treat missing as true.
outs = [o for o in json.loads(os.environ["FRAMEWALL_SCREENS"])["outputs"]
        if o.get("enabled", True) and o.get("connected", True)]

def is_physical(o):  # FRAMEWALL_EXTRA_PHYSICAL: test hook to treat outputs as physical
    return not o["name"].startswith("Virtual-") or o["name"] in extra

def geom(o):
    size = next(m["size"] for m in o["modes"] if m["id"] == o["currentModeId"])
    sw, sh = size["width"], size["height"]
    if o.get("rotation") in (2, 8):          # rotated left/right
        sw, sh = sh, sw
    scale = o.get("scale", 1) or 1
    return o["pos"]["x"], o["pos"]["y"], round(sw / scale), round(sh / scale), scale

phys = [o for o in outs if is_physical(o)]
if spec in ([], ["all"]):
    inc = phys
elif spec in (["primary"], ["auto"]):
    inc = sorted(phys, key=lambda o: o.get("priority") or 99)[:1]
elif spec == ["none"]:
    inc = []
else:
    names = {o["name"] for o in outs}
    for s in spec:
        if s not in names:
            print(f"WARN screen {s} not found (enabled outputs: {' '.join(sorted(names))})")
    inc = [o for o in outs if o["name"] in spec]
inc_names = {o["name"] for o in inc}
excluded = [o for o in outs if o["name"] not in inc_names and not o["name"].startswith("Virtual-wall")]

# Block of included physical screens, in their current arrangement.
block = {}
for o in inc:
    x, y, sw, sh, scale = geom(o)
    if scale != 1:
        print(f"WARN {o['name']} uses {round(scale * 100)}% scaling; the wall assumes 100%")
    block[o["name"]] = (x, y, sw, sh)
if block:
    bx0 = min(v[0] for v in block.values()); by0 = min(v[1] for v in block.values())
    bw = max(v[0] + v[2] for v in block.values()) - bx0
    bh = max(v[1] + v[3] for v in block.values()) - by0
else:
    bx0 = by0 = bw = bh = 0

virt = [f"Virtual-wall{i}" for i in range(1, n + 1)]
pos = {}          # name -> (x, y) relative to the wall's top-left
bpos = (0, 0)     # block's top-left relative to the wall
if shape == "top" or (shape == "grid" and n <= 1):
    row = n * w
    W = max(row, bw)
    for i, v in enumerate(virt):
        pos[v] = ((W - row) // 2 + i * w, 0)
    bpos = ((W - bw) // 2, h if n else 0)
    H = (h if n else 0) + bh
elif shape == "row":
    left = n // 2
    H = max(h if n else 0, bh)
    x = 0
    for v in virt[:left]:
        pos[v] = (x, (H - h) // 2); x += w
    bpos = (x, (H - bh) // 2); x += bw
    for v in virt[left:]:
        pos[v] = (x, (H - h) // 2); x += w
    W = x
elif shape == "grid":
    # Virtual monitors in rows above the block; pick the column count that
    # makes the whole wall closest to 16:9.
    best = None
    for cols in range(1, n + 1):
        gw, gh = cols * w, math.ceil(n / cols) * h
        W_, H_ = max(gw, bw), gh + bh
        score = abs(W_ / H_ - 16 / 9)
        if best is None or score < best[0]:
            best = (score, cols, gw, gh, W_, H_)
    _, cols, gw, gh, W, H = best
    for i, v in enumerate(virt):
        pos[v] = ((W - gw) // 2 + (i % cols) * w, (i // cols) * h)
    bpos = ((W - bw) // 2, gh)
else:
    sys.exit(f"unknown layout '{shape}' (top, row, grid)")

# Place the wall to the right of any screens left out of it.
ox = max((geom(o)[0] + geom(o)[2] for o in excluded), default=0)
oy = 0
print("WALL", W, H)
print("BLOCK", bw, bh)
print("REGION", ox, oy, W, H)
for name, (x, y, sw, sh) in block.items():
    nx, ny = ox + bpos[0] + (x - bx0), oy + bpos[1] + (y - by0)
    print("POS", name, nx, ny)
    print("SAVE", name, x, y)
# KWin may also nudge screens left out of the wall; put those back too.
for o in excluded:
    print("SAVE", o["name"], o["pos"]["x"], o["pos"]["y"])
for v in virt:
    print("POS", v, ox + pos[v][0], oy + pos[v][1])
PY
}

# Actual bounding box of the given outputs, read back from KWin: "x y w h".
bbox_of() {
    kscreen_json | python3 -c '
import json, sys
want = set(sys.argv[1:])
g = []
for o in json.load(sys.stdin)["outputs"]:
    if o["name"] in want and o.get("enabled", True):
        s = next(m["size"] for m in o["modes"] if m["id"] == o["currentModeId"])
        sw, sh = (s["height"], s["width"]) if o.get("rotation") in (2, 8) else (s["width"], s["height"])
        sc = o.get("scale", 1) or 1
        g.append((o["pos"]["x"], o["pos"]["y"], round(sw / sc), round(sh / sc)))
if g:
    x0, y0 = min(a[0] for a in g), min(a[1] for a in g)
    print(x0, y0, max(a[0] + a[2] for a in g) - x0, max(a[1] + a[3] for a in g) - y0)
' "$@"
}

# Moonlight app name for a preset; the client reads the stream size and
# refresh rate from it ("... @RATE ... (WxH)"). "+BWxBH" is the size of the
# physical-screen block: with it, the VR client can work out where every
# monitor sits in the stream (same layout rules as plan).
app_name() {   # count res hz shape BW BH W H
    echo "Wall ${1}x${2}@${3} ${4} +${5}x${6} (${7}x${8})"
}

# Smallest common Steam "Maximum game resolution" that fits a WxH wall, so the
# headset's Moonlight shows it 1:1 (bigger options cost headset GPU time).
steam_fit() {
    local W=$1 H=$2 r
    for r in 1920x1080 1920x1200 2560x1440 2560x1600 3840x2160 3840x2400 5120x2880; do
        (( ${r%x*} >= W && ${r#*x} >= H )) && { echo "$r"; return; }
    done
    echo "none fits (wider/taller than 5120x2880; Moonlight scales the wall down)"
}

preset_fields() {   # preset string -> "count w h hz shape"
    local count res hz shape
    read -r count res hz shape <<< "$1"
    [[ "$count" =~ ^[0-9]+$ && "$res" =~ ^[0-9]+x[0-9]+$ && "$hz" =~ ^[0-9]+$ ]] ||
        die "bad preset '$1' (expected: COUNT WIDTHxHEIGHT REFRESH LAYOUT)"
    echo "$count ${res%x*} ${res#*x} $hz ${shape:-top}"
}

wait_for_output() {
    local outs
    for _ in $(seq 1 75); do
        outs=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')
        grep -q "Output: [0-9]* $1 " <<< "$outs" && return 0
        sleep 0.2
    done
    return 1
}

cmd_apps() {
    local json p count w h hz shape W H BW BH out
    json=$(kscreen_json)
    for p in "${PRESETS[@]}"; do
        read -r count w h hz shape <<< "$(preset_fields "$p")"
        out=$(plan "$count" "$w" "$h" "$shape" <<< "$json")
        read -r _ W H <<< "$(grep '^WALL' <<< "$out")"
        read -r _ BW BH <<< "$(grep '^BLOCK' <<< "$out")"
        app_name "$count" "${w}x$h" "$hz" "$shape" "$BW" "$BH" "$W" "$H"
    done
}

cmd_up() {
    local preset="${1:-}"
    [[ -n "$preset" ]] || die "usage: framewall up COUNT WIDTHxHEIGHT REFRESH LAYOUT"
    local count w h hz shape
    read -r count w h hz shape <<< "$(preset_fields "$preset")"
    cmd_down
    mkdir -p "$SUNSHINE_DIR"
    # Snapshot the arrangement BEFORE adding virtual monitors: when they appear,
    # KWin may restore a layout it remembers for that set of screens, which
    # would move the physical screens before we look.
    local screens
    screens=$(kscreen_json)

    local i
    for i in $(seq 1 "$count"); do
        systemd-run --user --quiet --collect --unit="framewall-vmon$i" \
            krfb-virtualmonitor --name "wall$i" --resolution "${w}x$h" --scale 1 \
            --password "$(head -c 12 /dev/urandom | base64)" --port $((5910 + i))
        wait_for_output "Virtual-wall$i" || { cmd_down; die "Virtual-wall$i never appeared (journalctl --user -u framewall-vmon$i)"; }
        if [[ "$hz" != 60 ]]; then
            # krfb makes 60 Hz outputs; other rates are a KWin custom mode.
            kscreen-doctor "output.Virtual-wall$i.addCustomMode.$w.$h.$((hz * 1000)).full" >/dev/null 2>&1 || true
        fi
    done

    local planout
    planout=$(plan "$count" "$w" "$h" "$shape" <<< "$screens")
    { grep '^WARN ' <<< "$planout" || true; } | sed 's/^WARN /framewall: warning: /' >&2
    # Every screen's original position, put back by `down`.
    { grep '^SAVE ' <<< "$planout" || true; } | cut -d' ' -f2- > "$SUNSHINE_DIR/saved-layout"

    # Position everything in ONE call: KWin reshuffles screens moved one at a
    # time, and Sunshine maps the mouse using the positions at capture start.
    local args=() names=() tag name x y
    while read -r tag name x y; do
        [[ "$tag" == POS ]] || continue
        names+=("$name")
        args+=("output.$name.position.$x,$y")
        [[ "$name" == Virtual-wall* && "$hz" != 60 ]] && args+=("output.$name.mode.${w}x${h}@$hz")
    done <<< "$planout"
    (( ${#args[@]} )) || { cmd_down; die "nothing to show: no virtual monitors and no physical screens selected"; }
    kscreen-doctor "${args[@]}" >/dev/null 2>&1 || true
    sleep 1

    # Tell Sunshine exactly what to capture (read back: KWin has the final say
    # on positions).
    local region
    region=$(bbox_of "${names[@]}")
    echo "$region" > "$SUNSHINE_DIR/region"
    read -r _ _ W H <<< "$region"
    echo "framewall: ${count}x ${w}x${h}@${hz} ($shape) + ${#names[@]} screens -> stream ${W}x${H} (region $region)"
}

cmd_down() {
    systemctl --user stop 'framewall-vmon*.service' 2>/dev/null || true
    rm -f "$SUNSHINE_DIR/region"
    if [[ -s "$SUNSHINE_DIR/saved-layout" ]]; then
        local args=() name x y
        while read -r name x y; do args+=("output.$name.position.$x,$y"); done < "$SUNSHINE_DIR/saved-layout"
        kscreen-doctor "${args[@]}" >/dev/null 2>&1 || true
    fi
    rm -f "$SUNSHINE_DIR/saved-layout"
    return 0
}

cmd_install() {
    [[ -x "$SUNSHINE" ]] || die "patched Sunshine not found at $SUNSHINE (build it with sunshine/build.sh, or set SUNSHINE in $CONFIG)"
    command -v krfb-virtualmonitor >/dev/null || die "krfb-virtualmonitor not found (install krfb)"
    command -v kscreen-doctor >/dev/null || die "kscreen-doctor not found (install kscreen)"
    mkdir -p "$SUNSHINE_DIR" "$HOME/.config/systemd/user"

    # Moonlight apps, one per preset. ("env" is required: Sunshine aborts at
    # startup without it.)
    {
        echo '{'
        echo '    "env": {},'
        echo '    "apps": ['
        local p count w h hz shape sep="" names
        mapfile -t names < <(cmd_apps)
        local i=0
        for p in "${PRESETS[@]}"; do
            read -r count w h hz shape <<< "$(preset_fields "$p")"
            printf '%s        {\n            "name": "%s",\n            "image-path": "desktop.png",\n            "prep-cmd": [ { "do": "%s up %s", "undo": "%s down" } ]\n        }' \
                "$sep" "${names[$i]}" "$SELF" "$count ${w}x$h $hz $shape" "$SELF"
            sep=$',\n'
            i=$((i + 1))
        done
        printf '%s        { "name": "Physical screens only", "image-path": "desktop.png" }\n' "$sep"
        echo '    ]'
        echo '}'
    } > "$SUNSHINE_DIR/apps.json"
    python3 -m json.tool "$SUNSHINE_DIR/apps.json" >/dev/null || die "generated apps.json is invalid"

    cat > "$SUNSHINE_DIR/sunshine.conf" <<CONF
# Generated by framewall install; edits are overwritten (use $CONFIG).
sunshine_name = $NAME
port = $PORT
capture = kwin
output_name = workspace
encoder = $ENCODER
${ADAPTER:+adapter_name = $ADAPTER}
system_tray = disabled
file_apps = $SUNSHINE_DIR/apps.json
file_state = $SUNSHINE_DIR/state.json
credentials_file = $SUNSHINE_DIR/state.json
log_path = $SUNSHINE_DIR/sunshine.log
$EXTRA_SUNSHINE_CONFIG
CONF

    cat > "$HOME/.config/systemd/user/framewall.service" <<UNIT
[Unit]
Description=framewall: Sunshine monitor wall (virtual monitors on demand)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Environment=SUNSHINE_KWIN_WORKSPACE_REGION_FILE=$SUNSHINE_DIR/region
ExecStart=$SUNSHINE $SUNSHINE_DIR/sunshine.conf
ExecStopPost=$SELF down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable framewall.service >/dev/null
    systemctl --user restart framewall.service
    echo "framewall: Sunshine \"$NAME\" running on port $PORT"
    echo "  pair from Moonlight, then enter the PIN at https://localhost:$((PORT + 1))"
    echo "  firewall: allow TCP $((PORT - 5)),$PORT,$((PORT + 1)),$((PORT + 21)) and UDP $((PORT + 9))-$((PORT + 11)),$((PORT + 13))"
    echo "  apps (with Moonlight, set the headset's Steam \"Maximum game resolution\" as shown;"
    echo "  framewall-vr shows each monitor as its own panel and doesn't need it):"
    local a
    while IFS= read -r a; do
        if [[ "$a" == *" row "* ]]; then
            a="$a  ->  for framewall-vr"
        elif [[ "$a" =~ \(([0-9]+)x([0-9]+)\)$ ]]; then
            a="$a  ->  Steam: $(steam_fit "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")"
        fi
        echo "    $a"
    done < <(cmd_apps)
}

cmd_uninstall() {
    systemctl --user disable --now framewall.service 2>/dev/null || true
    rm -f "$HOME/.config/systemd/user/framewall.service"
    systemctl --user daemon-reload
    cmd_down
    echo "framewall: service removed (config and pairing kept in $CONFIG_DIR)"
}

cmd_status() {
    systemctl --user list-units --all --no-legend 'framewall*' 2>/dev/null || true
    kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -E '^Output|Geometry'
}

case "${1:-}" in
install)   cmd_install ;;
apps)      cmd_apps ;;
up)        shift; cmd_up "$*" ;;
down)      cmd_down ;;
status)    cmd_status ;;
uninstall) cmd_uninstall ;;
*)         sed -n '2,18p' "$SELF"; exit 2 ;;
esac
