# framewall host config: copy to ~/.config/framewall/config and edit.
# After changing anything, run `framewall install` again (pairing is kept).

# How this PC shows up in Moonlight.
NAME="$(hostname -s) wall"

# Sunshine base port. framewall's Sunshine is separate from any normal
# Sunshine you run (default 47989), so pick a port range that doesn't clash.
# Firewall: TCP PORT-5, PORT, PORT+1 (web UI), PORT+21; UDP PORT+9..PORT+11, PORT+13.
PORT=48389

# Patched Sunshine (built by sunshine/build.sh).
SUNSHINE="$HOME/.local/opt/sunshine-wall/bin/sunshine"

# Video encoder and GPU.
#   vaapi  - Intel/AMD (set ADAPTER to the GPU's render node)
#   nvenc  - NVIDIA (needs a Sunshine build with CUDA)
# On hybrid laptops the integrated GPU is a good choice: it keeps the
# discrete GPU free for games and lets it sleep.
ENCODER=vaapi
ADAPTER=/dev/dri/renderD128

# Physical screens in the wall. They keep their current arrangement (as one
# block) and the virtual monitors are added around it.
#   all            - every physical screen (default)
#   primary        - just the primary screen
#   "DP-1 DP-2"    - these outputs (names from `kscreen-doctor -o`)
#   none           - virtual monitors only
# Screens left out keep working where they are; the wall is placed to their
# right. (A left-out screen in the middle of the included ones leaves a gap.)
# Screens in the wall must use 100% scaling.
PHYSICAL=all

# Wall presets, one Moonlight app each:  "COUNT WIDTHxHEIGHT REFRESH LAYOUT"
#   COUNT    number of virtual monitors
#   REFRESH  virtual monitor refresh rate AND stream fps. Match your headset's
#            refresh rate (e.g. 90, 108, 120): a stream faster than the headset
#            wastes GPU time and can make head movement stutter.
#   LAYOUT   top  - virtual monitors in a row above the physical screens
#                   (e.g. 2x 1080p over a 1920x1200 laptop = 3840x2280, close
#                   to 16:9, so it fills a theater/cinema screen)
#            row  - physical screens in the middle, virtual monitors split
#                   left/right (wide; letterboxed on a 16:9 theater screen)
#            grid - virtual monitors in rows above the physical screens, with
#                   the column count that makes the wall closest to 16:9
PRESETS=(
    "2 1920x1080 120 top"
    "2 1920x1080 108 top"
    "2 1920x1080 90 top"
    "3 1920x1080 90 grid"
)

# Where Sunshine keeps its state (pairing), log and generated config.
#SUNSHINE_DIR="$HOME/.config/framewall/sunshine"

# Extra sunshine.conf lines, e.g. a smaller FEC share on a clean link:
#EXTRA_SUNSHINE_CONFIG="fec_percentage = 10"
