#!/usr/bin/env python3
# framewall-panels: resize and place framewall-vr's panels from the PC, live.
#
# A small window with a slider for each panel's size, plus distance, height
# and the gap between panels. Open it while framewall-vr is streaming: the
# window is on your PC's screen, so you see it in the headset and drag the
# sliders with the PC's mouse, and the panels change as you drag. framewall-vr
# saves the values to its settings file on the headset, so they stay.
#
# framewall-vr connects to this window (TCP, Sunshine's PORT + 5 from
# ~/.config/framewall/config), so it can be opened before or after the
# stream starts.
#
#   framewall-panels [--port N]
#
# Needs PySide6 or PyQt6.
#
# Copyright (C) 2026 framewall contributors. GPL-3.0-or-later.
import argparse
import os
import re
import sys

try:
    from PySide6.QtCore import Qt
    from PySide6.QtGui import QFont
    from PySide6.QtNetwork import QHostAddress, QTcpServer
    from PySide6.QtWidgets import (QApplication, QDoubleSpinBox, QFrame, QGridLayout, QGroupBox, QHBoxLayout,
                                   QLabel, QPushButton, QSlider, QVBoxLayout, QWidget)
except ImportError:
    from PyQt6.QtCore import Qt
    from PyQt6.QtGui import QFont
    from PyQt6.QtNetwork import QHostAddress, QTcpServer
    from PyQt6.QtWidgets import (QApplication, QDoubleSpinBox, QFrame, QGridLayout, QGroupBox, QHBoxLayout,
                                 QLabel, QPushButton, QSlider, QVBoxLayout, QWidget)

DEFAULT_PORT = 48389  # Sunshine base port, as in host/config.example
# Defaults, as in client/framewall-vr.conf.example.
DEFAULTS = {"SIZE": 1.0, "DISTANCE": 1.5, "HEIGHT": -0.1, "GAP": 0.03}


def sunshine_port():
    """PORT from ~/.config/framewall/config (a bash file; only a plain number is understood)."""
    conf = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "framewall", "config")
    try:
        with open(conf) as f:
            for line in f:
                m = re.match(r'\s*PORT=["\']?(\d+)["\']?\s*(#.*)?$', line)
                if m:
                    return int(m.group(1))
    except OSError:
        pass
    return DEFAULT_PORT


class Setting:
    """A slider with a number box for one setting. `scale` converts the shown
    number to the setting's value (e.g. % -> multiplier)."""

    def __init__(self, key, label, lo, hi, step, decimals, suffix, scale, on_change):
        self.key, self.scale, self.on_change = key, scale, on_change
        self.label = QLabel(label)
        self.steps = round(1 / step)
        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setRange(round(lo * self.steps), round(hi * self.steps))
        self.slider.setPageStep(max(1, round(self.steps * (hi - lo) / 20)))
        self.slider.setMinimumWidth(260)
        self.box = QDoubleSpinBox()
        self.box.setRange(lo, hi)
        self.box.setSingleStep(step)
        self.box.setDecimals(decimals)
        self.box.setSuffix(suffix)
        self.box.setKeyboardTracking(False)
        self.box.setMinimumWidth(96)
        self.slider.valueChanged.connect(self._slid)
        self.box.valueChanged.connect(self._typed)

    def add_to(self, grid, row):
        grid.addWidget(self.label, row, 0)
        grid.addWidget(self.slider, row, 1)
        grid.addWidget(self.box, row, 2)

    def remove(self):
        for w in (self.label, self.slider, self.box):
            w.setParent(None)
            w.deleteLater()

    def set_value(self, value):
        """Show a value from the headset, without sending it back."""
        shown = value / self.scale
        for w in (self.slider, self.box):
            w.blockSignals(True)
        # A value set by hand in the file may be outside the usual range: widen it.
        if shown < self.box.minimum() or shown > self.box.maximum():
            lo, hi = min(shown, self.box.minimum()), max(shown, self.box.maximum())
            self.box.setRange(lo, hi)
            self.slider.setRange(round(lo * self.steps), round(hi * self.steps))
        self.slider.setValue(round(shown * self.steps))
        self.box.setValue(shown)
        for w in (self.slider, self.box):
            w.blockSignals(False)

    def _slid(self, v):
        shown = v / self.steps
        self.box.blockSignals(True)
        self.box.setValue(shown)
        self.box.blockSignals(False)
        self.on_change(self.key, shown * self.scale)

    def _typed(self, shown):
        self.slider.blockSignals(True)
        self.slider.setValue(round(shown * self.steps))
        self.slider.blockSignals(False)
        self.on_change(self.key, shown * self.scale)


class Window(QWidget):
    def __init__(self, port):
        super().__init__()
        self.port = port
        self.sock = None
        self.buf = b""
        self.incoming = None  # snapshot being received: {"wall", "panels", "values"}
        self.panel_rows = []
        self.panel_widgets = []  # lines between rows of panels
        self.panel_keys = []

        self.setWindowTitle("Framewall panels")
        root = QVBoxLayout(self)

        self.status = QLabel()
        f = QFont(self.status.font())
        f.setBold(True)
        f.setPointSizeF(f.pointSizeF() * 1.15)
        self.status.setFont(f)
        self.wall = QLabel()
        self.wall.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        root.addWidget(self.status)
        root.addWidget(self.wall)

        self.sizes = QGroupBox("Panel sizes")
        self.sizes_grid = QGridLayout(self.sizes)
        self.sizes_grid.setColumnStretch(1, 1)
        self.sizes_grid.setColumnMinimumWidth(0, 150)
        self.size_all = Setting("SIZE", "All panels", 30, 300, 1, 0, " %", 0.01, self.send)
        self.size_all.add_to(self.sizes_grid, 0)
        line = QFrame()
        line.setFrameShape(QFrame.Shape.HLine)
        line.setFrameShadow(QFrame.Shadow.Sunken)
        self.sizes_grid.addWidget(line, 1, 0, 1, 3)
        root.addWidget(self.sizes)

        self.place = QGroupBox("Placement")
        grid = QGridLayout(self.place)
        grid.setColumnStretch(1, 1)
        grid.setColumnMinimumWidth(0, 150)
        self.place_rows = [
            Setting("DISTANCE", "Distance", 0.3, 5.0, 0.01, 2, " m", 1, self.send),
            Setting("HEIGHT", "Height", -1.5, 1.5, 0.01, 2, " m", 1, self.send),
            Setting("GAP", "Gap between panels", 0, 30, 0.1, 1, " cm", 0.01, self.send),
        ]
        for i, s in enumerate(self.place_rows):
            s.add_to(grid, i)
        for s in [self.size_all, *self.place_rows]:
            s.set_value(DEFAULTS[s.key])
        root.addWidget(self.place)

        buttons = QHBoxLayout()
        self.reset = QPushButton("Reset to defaults")
        self.reset.clicked.connect(self.reset_all)
        buttons.addWidget(self.reset)
        buttons.addStretch(1)
        close = QPushButton("Close")
        close.clicked.connect(self.close)
        buttons.addWidget(close)
        root.addLayout(buttons)

        self.note = QLabel("Changes show in the headset right away and are saved on the headset.")
        self.note.setWordWrap(True)
        self.note.setEnabled(False)  # greyed: a hint
        root.addWidget(self.note)

        self.server = QTcpServer(self)
        self.server.newConnection.connect(self.accept)
        if self.server.listen(QHostAddress(QHostAddress.SpecialAddress.Any), port):
            self.set_connected(False)
        else:
            self.set_connected(False, f"Can't listen on port {port}: {self.server.errorString()}"
                                      " (is framewall-panels already open?)")

    # ---- the headset link ------------------------------------------------------

    def accept(self):
        while self.server.hasPendingConnections():
            sock = self.server.nextPendingConnection()
            if self.sock is not None:  # a newer framewall-vr replaces the old one
                self.sock.disconnected.disconnect()
                self.sock.abort()
                self.sock.deleteLater()
            self.sock, self.buf, self.incoming = sock, b"", None
            sock.readyRead.connect(self.read)
            sock.disconnected.connect(self.dropped)
            peer = sock.peerAddress().toString().removeprefix("::ffff:")
            self.status.setText(f"Headset connecting ({peer})…")

    def dropped(self):
        if self.sock is not None:
            self.sock.deleteLater()
        self.sock = None
        self.set_connected(False)

    def read(self):
        sock = self.sock
        if sock is None:
            return
        self.buf += bytes(sock.readAll())
        while b"\n" in self.buf:
            raw, self.buf = self.buf.split(b"\n", 1)
            self.line(raw.decode("utf-8", "replace").rstrip("\r"))
        if len(self.buf) > 65536:  # not framewall-vr
            sock.abort()

    def line(self, line):
        cmd, _, rest = line.partition(" ")
        if cmd == "hello":
            self.incoming = {"wall": "", "panels": [], "values": {}}
        elif self.incoming is None:
            return
        elif cmd == "wall":
            self.incoming["wall"] = rest
        elif cmd == "panel":
            key, row, name = (rest.split(" ", 2) + ["", ""])[:3]
            self.incoming["panels"].append((key, int(row) if row.isdigit() else 1, name))
        elif cmd == "set":
            key, _, value = rest.partition(" ")
            try:
                self.incoming["values"][key] = float(value)
            except ValueError:
                pass
        elif cmd == "ready":
            self.show_snapshot(self.incoming)
            self.incoming = None

    def send(self, key, value):
        if self.sock is not None:
            self.sock.write(f"set {key} {value:.4g}\n".encode())

    # ---- the window --------------------------------------------------------------

    def set_connected(self, up, message=None):
        for w in (self.sizes, self.place, self.reset):
            w.setEnabled(up)
        if not up:
            self.status.setText(message or "Waiting for the headset…")
            self.wall.setText(f"Start framewall-vr on the headset; it connects here (port {self.port})."
                              if not message else "")

    def show_snapshot(self, snap):
        keys = [(k, r) for k, r, _ in snap["panels"]]
        if keys != self.panel_keys:  # another wall: rebuild the size rows
            for w in self.panel_widgets:
                w.setParent(None)
                w.deleteLater()
            for s in self.panel_rows:
                s.remove()
            self.panel_rows, self.panel_widgets = [], []
            grid_row, last = 2, None
            for key, row, name in snap["panels"]:
                if last is not None and row != last:  # a line between rows of panels
                    line = QFrame()
                    line.setFrameShape(QFrame.Shape.HLine)
                    line.setFrameShadow(QFrame.Shadow.Plain)
                    line.setEnabled(False)
                    self.sizes_grid.addWidget(line, grid_row, 0, 1, 3)
                    self.panel_widgets.append(line)
                    grid_row += 1
                last = row
                label = "PC screens" if name == "Screens" else name
                s = Setting(key, label, 30, 300, 1, 0, " %", 0.01, self.send)
                s.add_to(self.sizes_grid, grid_row)
                self.panel_rows.append(s)
                grid_row += 1
            self.panel_keys = keys
            self.adjustSize()
        values = snap["values"]
        for s in [self.size_all, *self.place_rows, *self.panel_rows]:
            s.set_value(values.get(s.key, DEFAULTS.get(s.key, 1.0)))
        self.status.setText("Connected to the headset")
        rows = len({r for _, r in keys})
        order = "top row first, each left to right" if rows > 1 else "left to right" if len(keys) > 1 else ""
        self.wall.setText(snap["wall"] + (f"  (panels {order})" if order else ""))
        self.set_connected(True)

    def reset_all(self):
        for s in [self.size_all, *self.place_rows, *self.panel_rows]:
            v = DEFAULTS.get(s.key, 1.0)
            s.set_value(v)
            self.send(s.key, v)


def main():
    ap = argparse.ArgumentParser(description="Resize framewall-vr's panels from the PC, live.")
    ap.add_argument("--port", type=int, help="port to listen on (default: Sunshine's PORT + 5)")
    args, qt_args = ap.parse_known_args()
    app = QApplication([sys.argv[0], *qt_args])
    app.setApplicationName("framewall-panels")
    app.setDesktopFileName("framewall-panels")
    w = Window(args.port or sunshine_port() + 5)
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
